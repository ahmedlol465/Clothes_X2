# ---------------------------------------------------------------- application
# Canonical NestJS API (teammate's foundation): http://localhost:3000/api
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=*
ENABLE_SWAGGER=true
SEED_ON_BOOT=true

# ------------------------------------------------------------------- database
# `postgres` is the primary target from the spec. When the server cannot be
# reached the API automatically falls back to the embedded SQLite file below.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=smartwardrobe
DB_SSL=false
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SQLITE_PATH=data/smartwardrobe.sqlite

# ---------------------------------------------------------------------- redis
# `auto` = use Redis when reachable, otherwise the in-process cache.
REDIS_MODE=auto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300
REDIS_KEY_PREFIX=sw:

# ------------------------------------------------------------------- security
JWT_ACCESS_SECRET=smartwardrobe-dev-access-secret
JWT_REFRESH_SECRET=smartwardrobe-dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# -------------------------------------------------------------------- storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage
STORAGE_PUBLIC_BASE_URL=http://localhost:30 00/api/storage
MAX_UPLOAD_BYTES=10485760

# --------------------------------------------------------- weather (NestJS)
# The Express stylist path is keyless (Open-Meteo) — see the bottom of this
# file. These are the NestJS module's settings.
WEATHER_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=
WEATHER_UNITS=metric
DEFAULT_LOCATION=Cairo
DEFAULT_COUNTRY=EG
WEATHER_CACHE_TTL=900

# -------------------------------------------------------------------------- AI
# `rule-engine` keeps scoring in-process. `http` proxies to the FastAPI service.
AI_MODE=rule-engine
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=20000
AI_MIN_MATCH_SCORE=55
AI_MAX_RECOMMENDATIONS=12

# --------------------------------------------------------------------- queues
QUEUE_ENABLED=false
QUEUE_NAME=smartwardrobe
QUEUE_CONCURRENCY=4

# ------------------------------------------------- legacy Express runtime
# server.js (the currently-working backend the Flutter app talks to) reads
# EXPRESS_PORT first so both backends can coexist:
#   Express → http://localhost:3001  (npm start, Flutter ApiConfig)
#   NestJS  → http://localhost:3000/api  (npm run start:nest)
EXPRESS_PORT=3001

# ========================================== local AI models (backend/.model-cache)
# The Express runtime loads two ONNX models locally with transformers.js,
# always from backend/.model-cache (never from a random/default cache):
#   Marqo/marqo-fashionCLIP          clothing analysis   (dtype=q8)
#   Xenova/all-MiniLM-L6-v2          semantic retrieval (dtype=q8)
# Model weights are NOT committed to git. After a fresh clone run once:
#   cd backend && npm install && npm run setup:models
# Files already present are never re-downloaded or overwritten.
# CLOTHING_VISION=on    # `off` disables the local clothing pipeline (422 with
#                       # error_type 'model_unavailable'). Keep `on`.
# EMBEDDINGS=on         # `off` forces lexical retrieval instead of MiniLM.

# ====================================================== AI Stylist (server.js)
# Everything below is OPTIONAL. With no key at all the stylist still answers
# from the rule engine (11-factor scoring, occasion detection, remixes, style
# memory), and GET /ai/capabilities reports exactly what is off.
#
# --- LLM (free tiers only, no card required)
# Gemini is the default; Groq / OpenRouter / OpenAI are drop-in alternatives.
# GEMINI_API_KEY → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GROQ_API_KEY=         # https://console.groq.com/keys
# OPENROUTER_API_KEY=   # https://openrouter.ai/keys
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini   # gemini | groq | openrouter | openai (auto-detect if unset)
# LLM_MODEL=gemini-flash-lite-latest
#   Optional: pin one exact model id. Leave unset to let the provider rotate
#   through its own candidate list on 404/429/5xx, which matters on free tiers
#   where individual model ids get retired.
# LLM_TIMEOUT_MS=25000  # per-request budget; a timeout falls back to the rules

# --- Weather: KEYLESS by default
# Open-Meteo needs no key. WEATHER_KEY is only an optional OpenWeatherMap
# fallback for anyone who already has a key.
# WEATHER_KEY=
WEATHER_CITY=Cairo
WEATHER_TTL_MINUTES=10

# --- Semantic retrieval: OPTIONAL local embeddings
# Retrieval works with no configuration at all (lexical scorer + category
# balancing). Install the encoder to upgrade it to real vector search:
#     npm run setup:models
# The model (Xenova/all-MiniLM-L6-v2, 384-dim) downloads once into
# backend/.model-cache on first use (or via npm run setup:models).
# If the package is missing, the model fails to load, or this is set to `off`,
# the server logs the reason and keeps using lexical retrieval.
EMBEDDINGS=on
