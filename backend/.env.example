# ---------------------------------------------------------------- application
# Canonical NestJS API. Keep this in sync with lib/core/api/api_config.dart
# (default http://localhost:3002). The old Express runtime is legacy only.
NODE_ENV=development
PORT=3002
API_PREFIX=api
CORS_ORIGINS=*
ENABLE_SWAGGER=true
SEED_ON_BOOT=true

# ------------------------------------------------------------------- database
# MySQL is the only datastore. The API needs a reachable MySQL server or it
# refuses to boot (there is no SQLite fallback).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=smartwardrobe
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---------------------------------------------------------------------- redis
# `auto` = use Redis when reachable, otherwise the in-process cache.
REDIS_MODE=auto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300
REDIS_KEY_PREFIX=sw:

# ------------------------------------------------------------------- security
# Generate strong secrets before deploying: `openssl rand -hex 32`
# Never commit real secrets to this file.
# Google sign-in: Web OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Web).
# Leave empty to disable the Google button (endpoint answers 'not configured').
GOOGLE_CLIENT_ID=

JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# -------------------------------------------------------------------- storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3002/api/storage
MAX_UPLOAD_BYTES=10485760

# --------------------------------------------------------- weather (NestJS)
# Keyless Open-Meteo by default — live data with zero configuration.
# Set WEATHER_PROVIDER=openweathermap with a key below to prefer that instead.
WEATHER_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=
WEATHER_UNITS=metric
DEFAULT_LOCATION=Cairo
DEFAULT_COUNTRY=EG
WEATHER_CACHE_TTL=900

# -------------------------------------------------------------------------- AI
# `rule-engine` keeps scoring in-process. `http` proxies to the FastAPI service.
AI_MODE=rule-engine
# Which clothing analyzer wardrobe/stylist use: local | python | auto.
# `local` needs the model cache; `python` uses AI_SERVICE_URL and falls back
# to local if the sidecar is down; `auto` picks python when AI_MODE=http.
AI_ANALYZER=local
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=20000
# Colour is read from the garment only (SAM 2 cutout) when the service answers.
# On by default; falls back to the whole photo if the service is down.
# Start it with: bash ai-service/run.sh   (about 6.7 s per photo on CPU, ~1 GB RAM)
# GARMENT_CUTOUT=off
# GARMENT_CUTOUT_TIMEOUT_MS=30000
AI_MIN_MATCH_SCORE=55
AI_MAX_RECOMMENDATIONS=12
# Floor below which an analysed attribute must not overwrite a user-typed value.
AI_MIN_STORE_CONFIDENCE=0.2

# --------------------------------------------------------------------- queues
QUEUE_ENABLED=false
QUEUE_NAME=smartwardrobe
QUEUE_CONCURRENCY=4

# ========================================== local AI models (backend/.model-cache)
# The Express runtime loads two ONNX models locally with transformers.js,
# always from backend/.model-cache (never from a random/default cache):
#   Marqo/marqo-fashionCLIP          clothing analysis   (dtype=q8)
#   Xenova/all-MiniLM-L6-v2          semantic retrieval (dtype=q8)
# Model weights are NOT committed to git. After a fresh clone run once:
#   cd backend && npm install && npm run setup:models
# Files already present are never re-downloaded or overwritten.
# CLOTHING_VISION=on    # `off` disables the local clothing pipeline (422 with
#                       # error_type 'model_unavailable'). Keep `on`.
# EMBEDDINGS=on         # `off` forces lexical retrieval instead of MiniLM.

# ====================================================== AI Stylist (server.js)
# Everything below is OPTIONAL. With no key at all the stylist still answers
# from the rule engine (11-factor scoring, occasion detection, remixes, style
# memory), and GET /ai/capabilities reports exactly what is off.
#
# --- LLM (free tiers only, no card required)
# Gemini is the default; Groq / OpenRouter / OpenAI are drop-in alternatives.
# GEMINI_API_KEY → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GROQ_API_KEY=         # https://console.groq.com/keys
# OPENROUTER_API_KEY=   # https://openrouter.ai/keys
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini   # gemini | groq | openrouter | openai (auto-detect if unset)
# LLM_MODEL=gemini-flash-lite-latest
#   Optional: pin one exact model id. Leave unset to let the provider rotate
#   through its own candidate list on 404/429/5xx, which matters on free tiers
#   where individual model ids get retired.
# LLM_TIMEOUT_MS=25000  # per-request budget; a timeout falls back to the rules

# --- Weather: KEYLESS by default
# Open-Meteo needs no key. WEATHER_KEY is only an optional OpenWeatherMap
# fallback for anyone who already has a key.
# WEATHER_KEY=
WEATHER_CITY=Cairo
WEATHER_TTL_MINUTES=10

# --- Semantic retrieval: OPTIONAL local embeddings
# Retrieval works with no configuration at all (lexical scorer + category
# balancing). Install the encoder to upgrade it to real vector search:
#     npm run setup:models
# The model (Xenova/all-MiniLM-L6-v2, 384-dim) downloads once into
# backend/.model-cache on first use (or via npm run setup:models).
# If the package is missing, the model fails to load, or this is set to `off`,
# the server logs the reason and keeps using lexical retrieval.
EMBEDDINGS=on
