# ---------------------------------------------------------------- application
# Canonical NestJS API (teammate's foundation): http://localhost:3000/api
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=*
ENABLE_SWAGGER=true
SEED_ON_BOOT=true

# ------------------------------------------------------------------- database
# `postgres` is the primary target from the spec. When the server cannot be
# reached the API automatically falls back to the embedded SQLite file below.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=smartwardrobe
DB_SSL=false
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SQLITE_PATH=data/smartwardrobe.sqlite

# ---------------------------------------------------------------------- redis
# `auto` = use Redis when reachable, otherwise the in-process cache.
REDIS_MODE=auto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300
REDIS_KEY_PREFIX=sw:

# ------------------------------------------------------------------- security
JWT_ACCESS_SECRET=smartwardrobe-dev-access-secret
JWT_REFRESH_SECRET=smartwardrobe-dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# -------------------------------------------------------------------- storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/storage
MAX_UPLOAD_BYTES=10485760

# -------------------------------------------------------------------- weather
WEATHER_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=
WEATHER_UNITS=metric
DEFAULT_LOCATION=Cairo
DEFAULT_COUNTRY=EG
WEATHER_CACHE_TTL=900

# -------------------------------------------------------------------------- AI
# `rule-engine` keeps scoring in-process. `http` proxies to the FastAPI service.
AI_MODE=rule-engine
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=20000
AI_MIN_MATCH_SCORE=55
AI_MAX_RECOMMENDATIONS=12

# --------------------------------------------------------------------- queues
QUEUE_ENABLED=false
QUEUE_NAME=smartwardrobe
QUEUE_CONCURRENCY=4

# ------------------------------------------------- legacy Express runtime
# server.js (the currently-working backend the Flutter app talks to) reads
# EXPRESS_PORT first so both backends can coexist:
#   Express → http://localhost:3001  (npm start, Flutter ApiConfig)
#   NestJS  → http://localhost:3000/api  (npm run start:nest)
EXPRESS_PORT=3001

# --- Free AI for server.js (Gemini: free key, no card → https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional alternatives (first key found wins, unless LLM_PROVIDER is set):
# GROQ_API_KEY=        # free: https://console.groq.com/keys
# OPENROUTER_API_KEY=  # free models: https://openrouter.ai/keys
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini # gemini | groq | openrouter | openai
# LLM_MODEL=gemini-2.0-flash

# --- Free live weather for server.js (https://openweathermap.org/api) — else stubbed demo
# WEATHER_KEY=
# WEATHER_CITY=Cairo
