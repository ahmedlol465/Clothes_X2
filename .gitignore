# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Secret env files — never commit keys.
/backend/.env
/backend/data/
/ai-service/.env
*.env

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node/NestJS backend
node_modules/
backend/dist/
backend/coverage/
backend/storage/
backend/data/
*.tsbuildinfo

# Local AI model weights (Marqo/marqo-fashionCLIP + Xenova/all-MiniLM-L6-v2).
# NOT committed — teammates obtain them via `npm run setup:models` (see README).
# The directory is safe to delete/clean on CI; production clones must not
# commit these ~255 MB of binary weights.
/backend/.model-cache/

# Environment files (.env.example is tracked on purpose)
.env
.env.*
!.env.example

# Playwright MCP debug artifacts
.playwright-mcp/
